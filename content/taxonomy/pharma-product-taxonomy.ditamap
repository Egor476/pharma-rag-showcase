<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE subjectScheme PUBLIC "-//OASIS//DTD DITA Subject Scheme Map//EN" "subjectScheme.dtd">

<subjectScheme id="pharma-product-taxonomy" xml:lang="en-US">

    <title>Pharma Product Taxonomy</title>

<!-- Products -->
    <subjectdef keys="therapeutic_products" navtitle="Therapeutic Products">
    <subjectdef keys="oncology_products" navtitle="Oncology Products">
      <subjectdef keys="onco_product_a" navtitle="Product A"/>
    </subjectdef>
    <subjectdef keys="cardiology_products" navtitle="Cardiology Products">
      <subjectdef keys="cardio_product_b" navtitle="Product B"/>
    </subjectdef>
  </subjectdef>

<!-- Audience -->
    <subjectdef keys="user_audience" navtitle="User Audience">
        <subjectdef keys="hcp" navtitle="Healthcare Provider (HCP)">
            <subjectdef keys="oncologist" navtitle="Oncologist"/>
            <subjectdef keys="cardiologist" navtitle="Cardiologist"/>
        </subjectdef>
        <subjectdef keys="patient" navtitle="Patient"/>
        <subjectdef keys="internal_regulatory" navtitle="Regulatory Reviewer"/>
    </subjectdef>

<!-- Content intent -->
    <subjectdef keys="content_intent" navtitle="Information Intent">
        <subjectdef keys="clinical_overview" navtitle="Clinical Overview and Mechanism"/>
        <subjectdef keys="dosing_guidelines" navtitle="Dosing and Administration"/>
        <subjectdef keys="safety_contraindications" navtitle="Contraindications and Warnings"/>
        <subjectdef keys="adverse_events" navtitle="Adverse Reactions and Side Effects"/>
    </subjectdef>

<!-- Product keys to product attribute -->
  <enumerationdef>
    <attributedef name="product"/>
    <subjectdef keyref="therapeutic_products"/>
  </enumerationdef>

  <!-- Audience keys to audience attribute -->
  <enumerationdef>
    <attributedef name="audience"/>
    <subjectdef keyref="user_audience"/>
  </enumerationdef>

  <!-- Content intent Keys to custom property attribute -->
  <enumerationdef>
    <attributedef name="otherprops"/>
    <subjectdef keyref="content_intent"/>
  </enumerationdef>

</subjectScheme>